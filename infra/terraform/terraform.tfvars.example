# Copy to terraform.tfvars (git-ignored) and fill in.
# Alternatively export TF_VAR_tws_userid / TF_VAR_tws_password etc.

tws_userid   = "your_ib_username"
tws_password = "your_ib_password"
trading_mode = "paper"

anthropic_api_key = "your_anthropic_api_key"

# Optional
telegram_bot_token = ""
telegram_chat_id   = ""
